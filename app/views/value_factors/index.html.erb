<style>
  table.dashboard-table td, table.dashboard-table th {
     padding: 0.5rem;
   }
</style>
<% if notice.present? %>
  <p id="notice" class="alert alert-primary"><%= notice %></p>
<% end %>
<!-- Title -->
<div class="row">
  <div class="col-12 mb-3">
    <h1 class="h3 mb-2 mb-sm-0">Task valuation variables</h1>
  </div>
</div>
<!-- Counter boxes START -->
<div class="row g-4 mb-4">
  <!-- Counter item -->
  <div class="col-md-6 col-xxl-8">
    <div class="card bg-warning bg-opacity-15 h-100">
      <div class="card-header bg-transparent d-flex justify-content-between align-items-baseline">
        <h5>Task evaluation</h5>
        <div class="dropdown">
          <a class="text-white" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-three-dots-vertical"></i>
          </a>
          <ul class="dropdown-menu">
            <li><%= link_to "New criteria", new_value_factor_path, class: "dropdown-item", data: { turbo_frame: "modal" } %></li>
            <li><a class="dropdown-item" href="#">Another action</a></li>
            <li><a class="dropdown-item" href="#">Something else here</a></li>
          </ul>
        </div>
      </div>
      <div class="card-body px-2 py-0">
        <table class="table table-hover dashboard-table">
          <thead>
            <tr>
              <th class=" ps-3">Criteria</th>
              <th class="text-end pe-5 ">Actions</th>
            </tr>
          </thead>
          <tbody id="value_factors">
            <% @value_factors.each do |value_factor| %>
              <%= content_tag :tr, id: dom_id(value_factor), class: dom_class(value_factor) do %>
                <td class="ps-3">
                  <p class="mb-0 mt-2"><a href="#" class=""><%=  value_factor.name %></a></p>
                </td>
                <td class="d-flex justify-content-end">
                  <%= link_to '<i class="bi bi-eye"></i>'.html_safe, value_factor, class: 'btn btn-light btn-round me-1 mb-1 mb-md-0', data: { bs_toggle: 'tooltip', bs_title: 'Edit', bs_custom_class: "dark-tooltip"} %>
                  <%= link_to '<i class="bi-pencil text-warning"></i>'.html_safe, edit_value_factor_path(value_factor), class: 'btn btn-light btn-round me-1 mb-1 mb-md-0', data: { bs_toggle: 'tooltip', bs_title: 'Edit', bs_custom_class: "dark-tooltip", turbo_frame: "modal"}  %>
                  <%= button_to '<i class="bi-trash-fill text-danger"></i>'.html_safe, value_factor, method: :delete, class: 'btn btn-light btn-round me-1 mb-1 mb-md-0', data: { confirm: 'Are you sure?', bs_toggle: 'tooltip', bs_title: 'Delete', bs_custom_class: "dark-tooltip"} %>
                </td>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>