<span class="mb-0 fs-1">🤔</span>
<h1 class="fs-2">Forgot Password?</h1>
<h5 class="fw-light mb-4">To receive a new password, enter your email address below.</h5>
<!-- Form START -->
<%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
  <%= f.error_notification %>
  <!-- Email -->
  <div class="mb-4">
    <label for="user_email" class="form-label">Email address *</label>
    <div class="input-group input-group-lg">
      <span class="input-group-text bg-light rounded-start border-0 text-secondary px-3"><i class="bi bi-envelope-fill"></i></span>
      <input class="form-control border-0 bg-light rounded-end ps-1" autocomplete="email" autofocus="autofocus" required="required" aria-required="true" type="email" value="" name="user[email]" id="user_email" placeholder="E-mail" id="exampleInputEmail1">
    </div>
  </div>
  <!-- Button -->
  <div class="align-items-center">
    <div class="d-grid">
      <%= f.button :submit, "Send me reset password instructions", class: 'btn btn-primary mb-0' %>
    </div>
  </div>
<% end %>
<br>
<%= render "devise/shared/links" %>
