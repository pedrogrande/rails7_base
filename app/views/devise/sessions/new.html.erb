<!-- Title -->
<span class="mb-0 fs-1">👋</span>
<h1 class="fs-2">Login into Eduport!</h1>
<p class="lead mb-4">Nice to see you! Please log in with your account.</p>
<!-- Form START -->
<%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <div class="mb-4">
    <label for="user_email" class="form-label">Email address *</label>
    <div class="input-group input-group-lg">
      <span class="input-group-text bg-light rounded-start border-0 text-secondary px-3"><i class="bi bi-envelope-fill"></i></span>
      <!--<input type="email" class="form-control border-0 bg-light rounded-end ps-1" placeholder="E-mail" id="exampleInputEmail1">-->
      <input class="form-control border-0 bg-light rounded-end ps-1" autocomplete="email" autofocus="autofocus" type="email" value="" name="user[email]" id="user_email" placeholder="Email">
    </div>
  </div>
  <div class="mb-4">
    <label for="user_password" class="form-label">Password *</label>
    <div class="input-group input-group-lg">
      <span class="input-group-text bg-light rounded-start border-0 text-secondary px-3"><i class="fas fa-lock"></i></span>
      <!--<input type="password" class="form-control border-0 bg-light rounded-end ps-1" placeholder="password" id="inputPassword5">-->
      <input class="form-control border-0 bg-light rounded-end ps-1" autocomplete="current-password" type="password" name="user[password]" id="user_password" placeholder="Password" >
    </div>
    <div id="passwordHelpBlock" class="form-text">
      Your password must be 8 characters at least 
    </div>
  </div>
  <div class="mb-4 d-flex justify-content-between mb-4">
    <div class="form-check">
      <!--<input type="checkbox" class="form-check-input" id="exampleCheck1">-->
      <input name="user[remember_me]" type="hidden" value="0" autocomplete="off">
      <input class="form-check-input boolean optional" type="checkbox" value="1" name="user[remember_me]" id="user_remember_me">
      <label class="form-check-label" for="user_remember_me">Remember me</label>
    </div>
    <div class="text-primary-hover">
      <a href="/users/password/new" class="text-secondary">
        <u>Forgot password?</u>
      </a>
    </div>
  </div>
  <div class="align-items-center mt-0">
    <div class="d-grid">
      <%= f.button :submit, "Log in", class: 'btn btn-primary mb-0' %>
    </div>
  </div>
<% end %>
<%# render "devise/shared/links" %>
<!-- Form END -->
<%= render 'devise/shared/altlogin' %>
<!-- Sign up link -->
<div class="mt-4 text-center">
  <span>Don't have an account? <a href="/users/sign_up">Signup here</a></span>
</div>