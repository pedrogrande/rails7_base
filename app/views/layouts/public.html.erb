<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
  <head>
    <title><%= content_for(:title) || "P2plearn" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= render 'layouts/partials/stylesheets' %>
    <%= render 'layouts/partials/javascript' %>
  </head>
  <body>
    <%= render 'layouts/partials/centered_navbar' %>
    <div class="container py-4">
      <%= yield %>
    </div>
    <%= render 'layouts/partials/big_footer' %>
  </body>
</html>
