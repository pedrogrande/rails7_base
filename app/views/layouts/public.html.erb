<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
  <head>
    <title><%= content_for(:title) || "P2plearn" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <!--<link href="https://fonts.cdnfonts.com/css/seven-segment" rel="stylesheet">-->
    <%= render 'layouts/partials/stylesheets' %>
    <%= stylesheet_link_tag "public", "data-turbo-track": "reload" %>
    <%= render 'layouts/partials/javascript' %>
    <%= javascript_importmap_tags %>
    <%= hotwire_livereload_tags if Rails.env.development? %>
  </head>
  <body>
    <%= render 'layouts/partials/centered_navbar' %>
    <div class="container p-4">
      <%= yield %>
    </div>
    <% render 'layouts/partials/big_footer' %>
  </body>
</html>
