<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
  <head>
    <title><%= content_for(:title) || "P2plearn" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <!--<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.6.0/css/fontawesome.min.css" integrity="sha256-XfA0ppGOANs88Ds+9FqVLy3xIGzT/25K/VLmRRxE9ow=" crossorigin="anonymous">-->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@5.15.4/css/all.min.css" integrity="sha256-mUZM63G8m73Mcidfrv5E+Y61y7a12O5mW4ezU3bxqW4=" crossorigin="anonymous">
    <!-- Dark mode -->
    <% render 'layouts/dashboard/darkmodejs' %>
    <%= render 'layouts/partials/stylesheets' %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= render 'layouts/partials/javascript' %>
    <%= javascript_importmap_tags %>
    <%= hotwire_livereload_tags if Rails.env.development? %>
    <style>
      body {
        font-family: 'Poppins', sans-serif;
        font-size: 16px;
        font-weight: 500;
        line-height: 1.5;
        text-align: left;
      }
      a {
        color: yellow;
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <!-- **************** MAIN CONTENT START **************** -->
    <main>
      <!-- Sidebar START -->
      <%= render 'layouts/dashboard/sidebar' %>
      <!-- Sidebar END -->
      <!-- Page content START -->
      <div class="page-content">
        <!-- Top bar START -->
        <%= render 'layouts/dashboard/topbar' %>
        <!-- Top bar END -->
        <!-- Page main content START -->
        <div class="page-content-wrapper border">
          <%= yield %>
        </div>
        <!-- Page main content END -->
      </div>
      <!-- Page content END -->
    </main>
    <div class="modal" tabindex="-1" data-controller="modal" data-action="turbo:frame-load->modal#open turbo:submit-end->modal#close">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <%= turbo_frame_tag "modal" %>
        </div>
      </div>
    </div>
    <!-- **************** MAIN CONTENT END **************** -->
    <!-- Back to top -->
    <div class="back-top"><i class="bi bi-arrow-up-short position-absolute top-50 start-50 translate-middle"></i></div>
    <!-- Bootstrap JS -->
    <%= render 'layouts/partials/js_bottom' %>
  </body>
</html>
